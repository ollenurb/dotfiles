// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // Workspace specific bindings
    "context": "Workspace",
    "bindings": {}
  },
  {
    // Open tab switcher
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "space i": "tab_switcher::Toggle",
      "space e n": "workspace::ToggleLeftDock",
      "space f": "file_finder::Toggle",
      "space l r": "editor::Rename",
      "space l k": "editor::GoToPreviousDiagnostic",
      "space l j": "editor::GoToDiagnostic",
      "space l a": "editor::ToggleCodeActions",
      "space l g": "editor::GoToImplementation",
      "space l h": "editor::Hover",
      "space l F": "editor::Format",
      "space l f": "editor::FormatSelections",
      "space t": "terminal_panel::ToggleFocus"
    }
  },
  {
    // Use vim mode in tab switcher menu
    "context": "TabSwitcher",
    "bindings": {
      "k": "menu::SelectPrevious",
      "j": "menu::SelectNext",
      "l": "menu::Confirm",
      "x": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "f": "editor::AutoIndent",
      ">": "editor::Indent",
      "<": "editor::Outdent",
      "=": "editor::AutoIndent"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "g w": "vim::Rewrap"
    }
  },
  {
    // netrw compatibility
    "context": "ProjectPanel && not_editing",
    "bindings": {
      ":": "command_palette::Toggle",
      "a": "project_panel::NewFile",
      "/": "project_panel::NewSearchInDirectory",
      "n": "project_panel::NewDirectory",
      "enter": "project_panel::OpenPermanent",
      "escape": "vim::ToggleProjectPanelFocus",
      "h": "project_panel::CollapseSelectedEntry",
      "j": "vim::MenuSelectNext",
      "k": "vim::MenuSelectPrevious",
      "down": "vim::MenuSelectNext",
      "up": "vim::MenuSelectPrevious",
      "l": "project_panel::ExpandSelectedEntry",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename"
    }
  },

  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "use_key_equivalents": true,
    "bindings": {
      // Vim mode on autocomplete menu
      "ctrl-k": "editor::ContextMenuPrevious",
      "ctrl-j": "editor::ContextMenuNext"
    }
  }
]
